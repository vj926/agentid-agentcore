    {"type":"rectangle","id":"spa","x":70,"y":230,"width":200,"height":140,"strokeColor":"#495057","backgroundColor":"#F3F2F1","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"spa-text","x":88,"y":250,"width":164,"height":100,"text":"Single-page app\n\nMSAL.js signs in user\nand requests agent.invoke","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"spa"},
    {"type":"rectangle","id":"authorizer","x":360,"y":220,"width":220,"height":155,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"authorizer-text","x":380,"y":240,"width":180,"height":115,"text":"AgentCore front door\n\nBuilt-in JWT authorizer\nchecks iss + aud + scp","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"authorizer"},
    {"type":"rectangle","id":"agent","x":620,"y":220,"width":210,"height":155,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"agent-text","x":640,"y":240,"width":170,"height":115,"text":"Agent container\n\nPython + MSAL\nruns FMI, then OBO","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"agent"},
    {"type":"rectangle","id":"sts","x":430,"y":500,"width":210,"height":120,"strokeColor":"#F7630C","backgroundColor":"#FFF4CE","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"sts-text","x":450,"y":520,"width":170,"height":80,"text":"AWS STS\n\nShort-lived signed\nrole assertion","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"sts"},
    {"type":"rectangle","id":"token-service","x":930,"y":220,"width":230,"height":155,"strokeColor":"#5C2D91","backgroundColor":"#E8DAEF","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"token-service-text","x":950,"y":240,"width":190,"height":115,"text":"Entra token service\n\nIssues user JWT, T1,\nand downstream TR","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"token-service"},
    {"type":"rectangle","id":"identity-model","x":930,"y":480,"width":230,"height":150,"strokeColor":"#5C2D91","backgroundColor":"#E8DAEF","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"identity-model-text","x":950,"y":500,"width":190,"height":110,"text":"Agent identity model\n\nBlueprint + federated\ncredential\n↓\nChild Agent Identity","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"identity-model"},
    {"type":"rectangle","id":"echo","x":1260,"y":230,"width":220,"height":140,"strokeColor":"#107C10","backgroundColor":"#DFF6DD","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
