    {"type":"arrow","id":"signin","x":170,"y":230,"width":760,"height":-20,"strokeColor":"#0078D4","strokeWidth":3,"strokeStyle":"dashed","points":[[0,0],[300,-50],[760,-20]],"startBinding":{"elementId":"spa","focus":0,"gap":1},"endBinding":{"elementId":"token-service","focus":0,"gap":1}},
    {"type":"text","id":"signin-label","x":480,"y":175,"width":230,"height":70,"text":"1  Sign in + request\nagent.invoke","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"top"},
