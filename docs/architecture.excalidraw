    {"type":"text","id":"a1-label","x":282,"y":230,"width":90,"height":70,"text":"2\nUser JWT","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"top"},
    {"type":"arrow","id":"a2","x":580,"y":295,"width":40,"height":0,"strokeColor":"#F7630C","strokeWidth":3,"points":[[0,0],[40,0]],"startBinding":{"elementId":"authorizer","focus":0,"gap":1},"endBinding":{"elementId":"agent","focus":0,"gap":1}},
    {"type":"text","id":"a2-label","x":580,"y":245,"width":55,"height":70,"text":"3\nvalidated","fontSize":13,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"top"},
