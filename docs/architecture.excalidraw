    {"type":"arrow","id":"a4","x":640,"y":560,"width":290,"height":0,"strokeColor":"#5C2D91","strokeWidth":3,"points":[[0,0],[290,0]],"startBinding":{"elementId":"sts","focus":0,"gap":1},"endBinding":{"elementId":"identity-model","focus":0,"gap":1}},
    {"type":"text","id":"a4-label","x":715,"y":505,"width":150,"height":90,"text":"5\nFMI\nAWS role → T1","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"top"},
    {"type":"arrow","id":"a5","x":830,"y":290,"width":100,"height":0,"strokeColor":"#5C2D91","strokeWidth":3,"points":[[0,0],[100,0]],"startBinding":{"elementId":"agent","focus":0,"gap":1},"endBinding":{"elementId":"token-service","focus":0,"gap":1}},
    {"type":"text","id":"a5-label","x":835,"y":230,"width":100,"height":90,"text":"6\nOBO\nT1 + user JWT","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"top"},
    {"type":"arrow","id":"a6","x":830,"y":300,"width":430,"height":20,"strokeColor":"#107C10","strokeWidth":3,"points":[[0,0],[240,100],[430,20]],"startBinding":{"elementId":"agent","focus":0,"gap":1},"endBinding":{"elementId":"echo","focus":0,"gap":1}},
    {"type":"text","id":"a6-label","x":1080,"y":360,"width":150,"height":75,"text":"7\nCall Echo with TR","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"top"},
    {"type":"arrow","id":"a7","x":830,"y":340,"width":430,"height":210,"strokeColor":"#107C10","strokeWidth":3,"points":[[0,0],[240,160],[430,210]],"startBinding":{"elementId":"agent","focus":0,"gap":1},"endBinding":{"elementId":"mcp","focus":0,"gap":1}},
    {"type":"text","id":"a7-label","x":1080,"y":430,"width":120,"height":75,"text":"8\nOptional MCP TR","fontSize":14,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"top"},

    {"type":"rectangle","id":"insight","x":190,"y":820,"width":1180,"height":90,"strokeColor":"#0078D4","backgroundColor":"#CFE4FA","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3}},
    {"type":"text","id":"insight-text","x":220,"y":837,"width":1120,"height":60,"text":"Key idea: AWS stores no reusable Entra secret. A short-lived AWS assertion proves the workload; OBO preserves the signed-in user for each downstream call.","fontSize":17,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"insight"}
