    {"type":"text","id":"title","x":60,"y":30,"width":900,"height":70,"text":"Entra Agent ID from AWS AgentCore","fontSize":30,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},
    {"type":"text","id":"subtitle","x":60,"y":82,"width":1100,"height":45,"text":"Secretless workload identity + user delegation across Entra ID and AWS","fontSize":17,"fontFamily":2,"strokeColor":"#000000","textAlign":"left","verticalAlign":"top"},

